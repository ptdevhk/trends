[Unit]
Description=Trends Preview Worker Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trends-preview
EnvironmentFile=-/home/ubuntu/trends-preview/.env.preview
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/uv run python -m apps.worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
