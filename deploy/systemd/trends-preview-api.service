[Unit]
Description=Trends Preview Hono BFF API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trends-preview
EnvironmentFile=-/home/ubuntu/trends-preview/.env.preview
Environment=NODE_ENV=production
Environment=PORT=3002
Environment=CONVEX_URL=http://127.0.0.1:4210
ExecStart=/usr/bin/node apps/api/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trends-preview-api

[Install]
WantedBy=multi-user.target
