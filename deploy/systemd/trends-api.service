[Unit]
Description=Trends Hono BFF API
After=network-online.target trends-convex.service
Wants=network-online.target trends-convex.service

[Service]
Type=simple
User=trends
Group=trends
WorkingDirectory=/opt/trends
EnvironmentFile=-/etc/trends/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx tsx apps/api/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trends-api

[Install]
WantedBy=multi-user.target
