# Trends preview environment (.env.preview)
# Copy this file to /home/ubuntu/trends-preview/.env.preview and fill in secrets.
# DO NOT commit secrets — this is a template only.

# AI
AI_API_KEY=
AI_API_BASE=https://api.poe.com/v1
AI_MODEL=openai/gpt-5.4-mini
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_RESUMES_ENABLED=true
AI_ANALYSIS_PARALLELISM=4
AI_OUTPUT_LOCALE=zh-Hans

# Convex (preview instance — isolated from production)
CONVEX_DEPLOY_KEY=
CONVEX_URL=http://convex:3210
CONVEX_PUBLIC_URL=https://preview.pt-mes.com/convex

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# S3
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Runtime
VITE_ANALYSIS_TOP_N=200
SUBMIT_RESUME_PARALLELISM=8
DEBUG=false
RESUME_SUBMIT_TOKEN=

# Timezone
TIMEZONE=Asia/Hong_Kong
TZ=Asia/Hong_Kong
VITE_APP_TIMEZONE=Asia/Hong_Kong
VITE_DEFAULT_LOCALE=zh-Hans

# Worker
WORKER_INTERVAL_MINUTES=360
