# Trends preview environment template (.env.preview)
# Install path: /home/ubuntu/trends-preview/.env.preview
# DO NOT commit real secrets — copy this template and fill values.
#
# Auth-ready for v0.4.9+ workspace/bootstrap admin flow.
# Validate: bunx tsx scripts/check-auth-env.ts --mode preview --env-file .env.preview

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_API_BASE=https://api.poe.com/v1
AI_MODEL=openai/gpt-5.4-mini
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_RESUMES_ENABLED=true
AI_ANALYSIS_PARALLELISM=4
AI_OUTPUT_LOCALE=zh-Hans

# ---------------------------------------------------------------------------
# Convex (preview — isolated from production)
# ---------------------------------------------------------------------------
CONVEX_DEPLOY_KEY=
# Host-mapped Docker port (NOT docker hostname convex:3210)
CONVEX_URL=http://127.0.0.1:4210
CONVEX_PUBLIC_URL=https://preview.pt-mes.com/convex
# Required for mutations / write paths (must be non-empty in preview)
CONVEX_WRITE_SECRET=

# ---------------------------------------------------------------------------
# Auth (required for preview)
# ---------------------------------------------------------------------------
AUTH_ALLOWED_ORIGINS=https://preview.pt-mes.com
# Session cookies (defaults shown)
# AUTH_SESSION_COOKIE_NAME=trends_session
# AUTH_CSRF_COOKIE_NAME=trends_csrf
# AUTH_SESSION_TTL_SECONDS=604800
# Admin password reset — leave false on preview unless intentionally testing
AUTH_ADMIN_RESET_ENABLED=false

# Bootstrap accounts (install / setup-preview / restore / upgrade reseed)
# Canonical only: admin@dev (ops) + hr-demo@hr (HR workspace with cloned statuses).
# Do NOT reseed failed product usernames.
BOOTSTRAP_ADMIN_USERS=admin
BOOTSTRAP_ADMIN_WORKSPACE=dev
BOOTSTRAP_ADMIN_PASSWORD_ENV=AUTH_BOOTSTRAP_PASSWORD
AUTH_BOOTSTRAP_PASSWORD=

BOOTSTRAP_HR_DEMO_USER=hr-demo
BOOTSTRAP_HR_DEMO_WORKSPACE=hr
BOOTSTRAP_HR_DEMO_PASSWORD_ENV=AUTH_HR_DEMO_PASSWORD
AUTH_HR_DEMO_PASSWORD=

# Optional dual memberships (default off)
# BOOTSTRAP_HR_DEMO_ALSO_DEV=false
# BOOTSTRAP_ADMIN_ALSO_HR=false

# After restore/upgrade: purge|ignore local users not in keep-set (default purge)
BOOTSTRAP_ORPHAN_LOCAL_USERS=purge
# BOOTSTRAP_ORPHAN_KEEP_USERS=

# OIDC (Casdoor / WeCom etc.) — enable only when issuer is ready
# AUTH_OIDC_ENABLED=true
# AUTH_OIDC_ISSUER=https://casdoor.example.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_REDIRECT_URI=https://preview.pt-mes.com/api/auth/oidc/callback
# AUTH_OIDC_SCOPE=openid profile email

# ---------------------------------------------------------------------------
# Notifications — keep empty on preview (isolation)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# S3 (optional)
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3002
VITE_ANALYSIS_TOP_N=200
SUBMIT_RESUME_PARALLELISM=8
DEBUG=false
RESUME_SUBMIT_TOKEN=
WORKER_INTERVAL_MINUTES=360

# ---------------------------------------------------------------------------
# Timezone / locale
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Hong_Kong
TZ=Asia/Hong_Kong
VITE_APP_TIMEZONE=Asia/Hong_Kong
VITE_DEFAULT_LOCALE=zh-Hans
