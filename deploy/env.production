# Trends production environment template
# Install path: /etc/trends/env (and mirror /opt/trends/.env.production)
# DO NOT commit real secrets — copy this template and fill values.
#
# Auth-ready for v0.4.9+ workspace/bootstrap admin flow.
# Validate: bunx tsx scripts/check-auth-env.ts --mode production --env-file .env.production
# Deploy: make on-prod-deploy  (from /opt/trends)

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_API_BASE=https://api.poe.com/v1
AI_MODEL=openai/openai-gpt-oss-120b
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_RESUMES_ENABLED=true
AI_ANALYSIS_PARALLELISM=4
AI_OUTPUT_LOCALE=zh-Hans

# ---------------------------------------------------------------------------
# Convex (production self-hosted)
# ---------------------------------------------------------------------------
# Self-hosted: leave CONVEX_DEPLOY_KEY empty
CONVEX_DEPLOY_KEY=
CONVEX_URL=http://127.0.0.1:3210
CONVEX_PUBLIC_URL=https://trends.pt-mes.com/convex
# Required for mutations / write paths
CONVEX_WRITE_SECRET=

# ---------------------------------------------------------------------------
# Auth (required for production)
# ---------------------------------------------------------------------------
AUTH_ALLOWED_ORIGINS=https://trends.pt-mes.com
# AUTH_SESSION_COOKIE_NAME=trends_session
# AUTH_CSRF_COOKIE_NAME=trends_csrf
# AUTH_SESSION_TTL_SECONDS=604800
# Admin password reset — must stay false unless deliberately enabled
AUTH_ADMIN_RESET_ENABLED=false

# Bootstrap admin seeding (first install / upgrade seed_bootstrap_admins)
# BOOTSTRAP_ADMIN_USERS=admin
# BOOTSTRAP_ADMIN_WORKSPACE=dev
# BOOTSTRAP_ADMIN_PASSWORD_ENV=AUTH_BOOTSTRAP_PASSWORD
# AUTH_BOOTSTRAP_PASSWORD=

# OIDC (Casdoor / WeCom etc.)
# AUTH_OIDC_ENABLED=true
# AUTH_OIDC_ISSUER=https://casdoor.example.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_REDIRECT_URI=https://trends.pt-mes.com/api/auth/oidc/callback
# AUTH_OIDC_SCOPE=openid profile email

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# S3 (optional)
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# PORT=3000
# WORKER_URL=http://127.0.0.1:8000
# PROJECT_ROOT=/opt/trends
SUBMIT_RESUME_PARALLELISM=8
RESUME_SUBMIT_TOKEN=
DEBUG=false
WORKER_INTERVAL_MINUTES=30
VITE_ANALYSIS_TOP_N=200

# ---------------------------------------------------------------------------
# Timezone / locale
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Hong_Kong
TZ=Asia/Hong_Kong
VITE_APP_TIMEZONE=Asia/Hong_Kong
VITE_DEFAULT_LOCALE=zh-Hans
