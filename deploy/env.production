# Trends production environment template
# Copied to /etc/trends/env on first install.

# AI and notifications
AI_API_KEY=
AI_API_BASE=https://api.poe.com/v1
AI_MODEL=openai/openai-gpt-oss-120b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Convex backend
# Self-hosted (default): leave CONVEX_DEPLOY_KEY empty
# Cloud: set CONVEX_DEPLOY_KEY from https://dashboard.convex.dev
CONVEX_DEPLOY_KEY=
CONVEX_URL=http://127.0.0.1:3210
# Public URL for browser access (through Caddy reverse proxy).
# Required for self-hosted mode; cloud mode URLs are already public.
CONVEX_PUBLIC_URL=https://trends.pt-mes.com/convex

# Runtime behavior
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_RESUMES_ENABLED=true
AI_ANALYSIS_PARALLELISM=4
SUBMIT_RESUME_PARALLELISM=8
RESUME_SUBMIT_TOKEN=
DEBUG=false

# Timezone and locale
TIMEZONE=Asia/Hong_Kong
TZ=Asia/Hong_Kong
VITE_APP_TIMEZONE=Asia/Hong_Kong
AI_OUTPUT_LOCALE=zh-Hans
VITE_DEFAULT_LOCALE=zh-Hans

# Optional API/worker overrides
# PORT=3000
# WORKER_URL=http://127.0.0.1:8000
# PROJECT_ROOT=/opt/trends
# WORKER_INTERVAL_MINUTES=30
# WORKER_CRON=
