# Copy to .env for development: cp .env.example .env
# Or to ~/.secrets/com.trends.app.env for direnv users

# Convex backend
# CONVEX_URL=http://127.0.0.1:3210
# Public URL for browser access to self-hosted Convex (through reverse proxy).
# Not needed for Convex Cloud or local dev. Required for production self-hosted.
# CONVEX_PUBLIC_URL=https://your-domain.com/convex

AI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AI_ANALYSIS_ENABLED=true
AI_ANALYSIS_PARALLELISM=4
SUBMIT_RESUME_PARALLELISM=8
DEBUG=true
TIMEZONE=Asia/Hong_Kong
TZ=Asia/Hong_Kong
VITE_APP_TIMEZONE=Asia/Hong_Kong
# Language / Locale (BCP47 format: zh-Hans, zh-Hant, en)
AI_OUTPUT_LOCALE=zh-Hans      # AI analysis output language (resume system)
VITE_DEFAULT_LOCALE=zh-Hans   # Frontend UI / static content default language
