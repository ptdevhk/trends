{
  "browser": {
    "browserName": "chromium",
    "cdpEndpoint": "http://localhost:9222",
    "launchOptions": {
      "headless": false,
      "channel": "chrome"
    },
    "contextOptions": {
      "viewport": { "width": 1280, "height": 720 }
    }
  },
  "outputDir": ".playwright-cli",
  "outputMode": "stdout",
  "timeouts": {
    "action": 5000,
    "navigation": 30000
  }
}
