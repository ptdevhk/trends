{
  "name": "trends",
  "private": true,
  "version": "0.4.10",
  "description": "Chinese news hot topic aggregator and analysis tool",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:mcp": "./scripts/dev.sh --mcp-only",
    "dev:crawl": "./scripts/dev.sh --crawl-only",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "dev:worker": "cd apps/worker && uv run uvicorn main:app --reload --port 8000",
    "check": "bun run check:resume-ai-prompts && bun run check:resume-field-usage-policy && bun run check:search-profile-templates && bun run check:resume-skills-locales && bun run check:typecheck && bun run check:lint",
    "check:typecheck": "bun run --filter '@trends/*' typecheck",
    "check:lint": "bun run --filter '@trends/web' --filter '@trends/browser-extension' lint",
    "check:build": "bun run --filter '@trends/*' build",
    "sync:resume-ai-prompts": "tsx scripts/resume/sync-ai-prompts.ts",
    "check:resume-ai-prompts": "tsx scripts/resume/sync-ai-prompts.ts --check",
    "sync:resume-field-usage-policy": "tsx scripts/resume/sync-field-usage-policy.ts",
    "check:resume-field-usage-policy": "tsx scripts/resume/sync-field-usage-policy.ts --check",
    "sync:search-profile-templates": "tsx scripts/resume/sync-search-profile-templates.ts",
    "check:search-profile-templates": "tsx scripts/resume/sync-search-profile-templates.ts --check",
    "check:resume-skills-locales": "tsx scripts/resume/check-skills-locales.ts",
    "test": "vitest run",
    "test:extension:keyword-mode": "tsx scripts/test-extension-keyword-mode.ts",
    "test:api:search-profiles": "vitest run apps/api/src/routes/search-profiles.test.ts",
    "test:e2e:collect-url": "tsx scripts/e2e-smoke.ts --collect-only",
    "test:e2e:live-job5156-detail": "tsx scripts/e2e-smoke.ts --live-job5156-detail https://hr.job5156.com/resume/view/987654",
    "test:e2e:live-seek-my": "tsx scripts/e2e-smoke.ts --live-seek-my-recommended https://my.employer.seek.com/candidates/recommended?jobId=90842915&pageNumber=1",
    "verify:critical-path": "tsx scripts/verify-critical-path.ts",
    "verify:workflow-dataset": "tsx scripts/resume/verify-workflow-dataset.ts",
    "clear:workspace-demo-resumes": "tsx scripts/resume/clear-workspace-demo-resumes.ts",
    "auth:bootstrap-demo": "tsx scripts/auth/manage-user.ts --username demo-admin --email demo-admin@example.com --display-name \"Demo Admin\" --workspace dev --role admin --replace-memberships --password-env AUTH_BOOTSTRAP_PASSWORD --output json",
    "verify:industry-scores": "tsx scripts/verify-industry-scores.ts",
    "verify:industry-scores:round-trip": "tsx scripts/verify-industry-scores.ts --sample sample-job5156-detail-enriched --round-trip",
    "e2e": "tsx scripts/e2e-smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptdevhk/trends.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
